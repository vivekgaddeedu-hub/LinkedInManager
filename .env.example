# ==============================================================================
# LinkedIn AI Personal Manager – MCP Server Configuration
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Public Base URL of your deployed server (MUST match where you host the app)
# Examples:
#   Local:      http://localhost:3000
#   Render:     https://linkedin-mcp-personal.onrender.com
#   Railway:    https://linkedin-mcp-personal.up.railway.app
PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# LinkedIn Developer Application Credentials
# Obtain these from: https://www.linkedin.com/developers/apps
# ------------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# Must match EXACTLY what is registered in LinkedIn Developer Portal under
# Auth -> Authorized redirect URLs for your app:
# e.g., https://your-server-domain.com/auth/callback
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/callback

# ------------------------------------------------------------------------------
# Security & Token Encryption
# 32-byte secret key used for AES-256-GCM encryption of stored OAuth credentials.
# Generate a new random key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
ENCRYPTION_KEY=replace_with_a_secure_random_64_character_hex_string

# Path where encrypted tokens are stored at rest
TOKEN_STORAGE_PATH=./data/tokens.enc

# ------------------------------------------------------------------------------
# Optional MCP Bearer Token Protection
# If set, Claude AI Custom Connector must include this token in Authorization: Bearer <token>
# Leave blank to allow Claude to connect without an extra connector API key
# ------------------------------------------------------------------------------
MCP_AUTH_TOKEN=
